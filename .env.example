# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32-byte key, base64-encoded. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Use the publishable key, or the legacy ANON key below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CLEAR Free provider. Requests stay on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Set to "mock" to generate lessons without calling Gemini.
CLEAR_PROVIDER=

# Optional platform integrations
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Configurable product limits
GUEST_DAILY_REQUEST_LIMIT=20
USER_DAILY_REQUEST_LIMIT=100
MAX_UPLOAD_MB=3
MAX_PDF_PAGES=40
# Vercel always caps an upload batch at 3 MiB and multipart requests at 4 MiB.

# Only trust a header that the deployment edge overwrites. Vercel overwrites this.
CLEAR_TRUSTED_IP_HEADER=x-vercel-forwarded-for
# Optional independent HMAC secret (32+ characters); otherwise encryption key is used.
CLEAR_LIMITS_SECRET=
CLEAR_FREE_IP_DAILY_LIMIT=20
CLEAR_FREE_GLOBAL_DAILY_LIMIT=1000
CLEAR_PROVIDER_CONCURRENCY_LIMIT=8
# Operational pauses, checked before dispatch. BYOK never spends CLEAR Free quota.
CLEAR_FREE_PAUSED=false
CLEAR_AI_PAUSED=false
# Local development only. Hosted Vercel storage requires Supabase.
CLEAR_DATA_DIR=
# Optional overrides: CLEAR_RATE_GENERATION_IP_LIMIT, _GUEST_LIMIT, _WINDOW_SECONDS.
# Equivalent prefixes: UPLOAD, PROVIDER_TEST, AUTH, SHARE, EXPORT, SKILL, MUTATION.
CLEAR_MAX_JSON_BYTES=65536
# Bounds streamed upstream responses, including misleading content lengths (max 4 MiB).
CLEAR_PROVIDER_RESPONSE_MAX_BYTES=1048576
